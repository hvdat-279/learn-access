{
  "expo": {
    "name": "LearnAccess",
    "slug": "learnaccess",
    "scheme": "learnaccess",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.learningaccess.learnaccess",
      "infoPlist": {
        "NSCameraUsageDescription": "Chụp tài liệu để chuyển thành nội dung dễ đọc.",
        "NSPhotoLibraryUsageDescription": "Chọn ảnh tài liệu để nhận diện chữ."
      }
    },
    "android": {
      "package": "com.learningaccess.learnaccess",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#5945C6"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chọn ảnh tài liệu để nhận diện chữ.",
          "cameraPermission": "Chụp tài liệu để chuyển thành nội dung dễ đọc.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d57c85ea-6c48-404c-86b7-a5e7b616a045"
      }
    },
    "owner": "tuaw_khoiii"
  }
}
